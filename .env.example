# Copy to .env and fill in. Nothing here is committed except this example file.

# ---- Credentials -----------------------------------------------------------
# You can put the three secrets below directly here, OR point the sync at an
# existing service's .env file via TICKTICK_ENV_PATH / ICLOUD_ENV_PATH so the
# secret is stored in exactly one place (resolution order: environment -> this
# file -> the referenced external file).

# TickTick V1 Open API OAuth access token.
TICKTICK_ACCESS_TOKEN=

# iCloud Apple ID and an app-specific password (NOT your main Apple ID password).
# Generate one at https://account.apple.com -> Sign-In & Security -> App-Specific Passwords.
ICLOUD_USERNAME=you@example.com
ICLOUD_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional: read the secrets above from external service .env files instead.
# TICKTICK_ENV_PATH=/path/to/ticktick-service/.env
# ICLOUD_ENV_PATH=/path/to/icloud-service/.env

# ---- Sync settings ---------------------------------------------------------
TICKTICK_TIMEZONE=America/New_York
CALDAV_URL=https://caldav.icloud.com
CALENDAR_NAME=TickTick Tasks
EVENT_DEFAULT_DURATION_MIN=30

# Rolling window in days for future tasks. Unset = sync all active timed tasks.
# SYNC_HORIZON_DAYS=30

# ---- Two-way sync (write calendar-side edits back to TickTick) --------------
# Leave false until you have verified a dry-run; flip to true to enable write-back.
TWO_WAY_ENABLED=false

# How a deleted calendar event maps onto TickTick:
#   ignore   (safe default) — never writes back; a still-active task whose event is
#            gone is simply re-created (healed), so an empty calendar is non-destructive
#   complete — mark the TickTick task complete (recoverable)
#   delete   — delete the TickTick task (permanent)
CAL_DELETION_MEANS=ignore

# Safety guard: if this many or more tracked events vanish in a single pass (and a
# majority are gone), abort the run instead of acting — that pattern is an iCloud
# listing/collection failure, not real user deletions.
MASS_MISSING_ABORT=5

# ---- Multi-calendar routing (optional) -------------------------------------
# Route specific TickTick projects to a separate calendar (e.g. habits/routines).
# Comma-separated TickTick project ids; unset = everything goes to CALENDAR_NAME.
HABITS_CALENDAR_NAME=Habits & Routines
# HABITS_PROJECT_IDS=your_project_id_here
